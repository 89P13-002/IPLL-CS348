Grammar

    0 $accept: translation_unit $end

    1 primary_expression: IDENTIFIER
    2                   | CONSTANT
    3                   | STRING
    4                   | LPAREN expression RPAREN

    5 CONSTANT: INTCONST
    6         | FLOATCONST
    7         | CHARCONST

    8 postfix_expression: primary_expression
    9                   | postfix_expression LBRACKET expression RBRACKET
   10                   | postfix_expression LPAREN argument_expression_list_opt RPAREN
   11                   | postfix_expression DEREF IDENTIFIER

   12 argument_expression_list: assignment_expression
   13                         | argument_expression_list COMMA assignment_expression

   14 argument_expression_list_opt: argument_expression_list
   15                             | ε

   16 unary_expression: postfix_expression
   17                 | unary_operator unary_expression

   18 unary_operator: BITAND
   19               | MULT
   20               | ADD
   21               | SUB
   22               | LOGICALNOT

   23 multiplicative_expression: unary_expression
   24                          | multiplicative_expression MULT unary_expression
   25                          | multiplicative_expression DIV unary_expression
   26                          | multiplicative_expression MOD unary_expression

   27 additive_expression: multiplicative_expression
   28                    | additive_expression ADD multiplicative_expression
   29                    | additive_expression SUB multiplicative_expression

   30 relational_expression: additive_expression
   31                      | relational_expression LESS additive_expression
   32                      | relational_expression GREATER additive_expression
   33                      | relational_expression LESSEQUAL additive_expression
   34                      | relational_expression GREATEREQUAL additive_expression

   35 equality_expression: relational_expression
   36                    | equality_expression EQUALITY relational_expression
   37                    | equality_expression NOTEQUAL relational_expression

   38 logical_AND_expression: equality_expression
   39                       | logical_AND_expression LOGICALAND equality_expression

   40 logical_OR_expression: logical_AND_expression
   41                      | logical_OR_expression LOGICALOR logical_AND_expression

   42 conditional_expression: logical_OR_expression
   43                       | logical_OR_expression QUESTION expression COLON conditional_expression

   44 assignment_expression: conditional_expression
   45                      | unary_expression ASSIGN assignment_expression

   46 expression: assignment_expression

   47 declaration: type_specifier init_declarator SEMICOLON

   48 init_declarator: declarator
   49                | declarator ASSIGN initializer

   50 type_specifier: VOID
   51               | CHAR
   52               | INTEGER
   53               | FLOAT
   54               | BOOL

   55 declarator: pointer_opt direct_declarator

   56 direct_declarator: IDENTIFIER
   57                  | IDENTIFIER LBRACKET INTCONST RBRACKET
   58                  | IDENTIFIER LPAREN parameter_list_opt RPAREN

   59 pointer: MULT

   60 pointer_opt: pointer
   61            | ε

   62 parameter_list: parameter_declaration
   63               | parameter_list COMMA parameter_declaration

   64 parameter_list_opt: parameter_list
   65                   | ε

   66 parameter_declaration: type_specifier pointer_opt identifier_opt

   67 identifier_opt: IDENTIFIER
   68               | ε

   69 initializer: assignment_expression

   70 statement: compound_statement
   71          | expression_statement
   72          | selection_statement
   73          | iteration_statement
   74          | jump_statement

   75 compound_statement: BEGINBLOCK block_item_list_opt END

   76 block_item_list: block_item
   77                | block_item_list block_item

   78 block_item_list_opt: block_item_list
   79                    | ε

   80 block_item: declaration
   81           | statement

   82 expression_statement: expression_opt SEMICOLON

   83 selection_statement: IF LPAREN expression RPAREN statement
   84                    | IF LPAREN expression RPAREN statement ELSE statement

   85 iteration_statement: FOR LPAREN expression_opt SEMICOLON expression_opt SEMICOLON expression_opt RPAREN statement

   86 jump_statement: RETURN expression_opt SEMICOLON

   87 expression_opt: expression
   88               | ε

   89 translation_unit: external_declaration
   90                 | translation_unit external_declaration

   91 external_declaration: function_definition
   92                     | function_declaration
   93                     | variable_declaration

   94 variable_declaration: type_specifier IDENTIFIER SEMICOLON
   95                     | type_specifier IDENTIFIER LBRACKET INTCONST RBRACKET SEMICOLON
   96                     | type_specifier MULT IDENTIFIER SEMICOLON
   97                     | type_specifier IDENTIFIER ASSIGN initializer SEMICOLON

   98 function_declaration: type_specifier function_declarator SEMICOLON

   99 function_declarator: direct_function_declarator
  100                    | MULT direct_function_declarator

  101 direct_function_declarator: IDENTIFIER LPAREN parameter_list_opt RPAREN

  102 function_definition: type_specifier function_declarator compound_statement


